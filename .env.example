# Neon: pooled connection string (host contains "-pooler"), used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: direct (non-pooled) connection string, used by migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Login password for the app, and a long random string used to sign the login cookie
APP_PASSWORD="choose-a-password"
SESSION_SECRET="generate with: openssl rand -hex 32"
