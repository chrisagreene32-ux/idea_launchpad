generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Status {
  NEW
  INTERVIEWED
  BUILDING
  PARKED
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Effort {
  QUICK_WIN
  FEW_HOURS
  BIG_PROJECT
}

enum Outcome {
  SHIPPED
  PARKED
  ABANDONED
}

model Idea {
  id               String    @id @default(cuid())
  text             String
  tags             String[]  @default([])
  status           Status    @default(NEW)
  project          String?
  priority         Priority?
  effort           Effort?
  nextStep         String?
  outcome          Outcome?
  claudeProjectUrl String?
  brief            String?
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
}

model OAuthClient {
  id           String   @id
  name         String?
  redirectUris String[]
  createdAt    DateTime @default(now())
}

model OAuthCode {
  codeHash      String   @id
  clientId      String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
}

model OAuthRefreshToken {
  tokenHash String   @id
  clientId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ProjectStatus {
  ACTIVE
  WAITING
  PARKED
  DONE
}

enum SessionKind {
  CHAT
  CODE
}

enum SessionStatus {
  ACTIVE
  HANDED_OFF
  DONE
}

// A project is something you are working on across many Claude chats and Code
// sessions. `holder` is who has the baton right now ("Chris" or "Kat").
model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  status      ProjectStatus @default(ACTIVE)
  holder      String        @default("Chris")
  batonSince  DateTime      @default(now())
  deadline    DateTime?
  nextAction  String?
  blockedOn   String?
  notes       String?
  repoUrl     String?
  claudeProjectUrl String?
  ideaId      String?
  nextSeq     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  sessions    Session[]
}

// One chat or Code session in a project's numbered chain.
model Session {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq       Int
  goal      String
  kind      SessionKind   @default(CHAT)
  driver    String        @default("Chris")
  status    SessionStatus @default(ACTIVE)
  url       String?
  branch    String?
  handoff   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@unique([projectId, seq])
  @@index([projectId, seq])
}
