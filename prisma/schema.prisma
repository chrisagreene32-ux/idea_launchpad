generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Status {
  NEW
  INTERVIEWED
  BUILDING
  PARKED
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Effort {
  QUICK_WIN
  FEW_HOURS
  BIG_PROJECT
}

enum Outcome {
  SHIPPED
  PARKED
  ABANDONED
}

model Idea {
  id               String    @id @default(cuid())
  text             String
  tags             String[]  @default([])
  status           Status    @default(NEW)
  project          String?
  priority         Priority?
  effort           Effort?
  nextStep         String?
  outcome          Outcome?
  claudeProjectUrl String?
  brief            String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
}
